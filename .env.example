# Copy to .env and fill in. Never commit .env.

# Groq - https://console.groq.com  (free tier)
GROQ_API_KEY=gsk_xxx

# Google AI Studio - https://aistudio.google.com  (free tier, no card)
# Used by the evaluation judge only.
GOOGLE_API_KEY=xxx

# Neo4j. For Aura, copy the URI from the instance page.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=xxx

# Aura names the database after the instance id, not "neo4j".
# Find it on the instance page. Omitting this causes
# "database 'neo4j' does not exist" at startup.
NEO4J_DATABASE=xxxxxxxx